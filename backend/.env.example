# Pick one LLM (Gemini is used first when both are set). Leave empty for offline dummy replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=auto   # auto | gemini | openai | fallback

# AI scenes and stickers use the same keys.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# IMAGE_PROVIDER=auto  # auto | gemini | openai | fallback

# Powers voices and AI voice design. Leave empty to use the phone's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional shared secret; set the same value as EXPO_PUBLIC_APP_KEY in the app.
APP_API_KEY=
